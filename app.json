{
  "expo": {
    "name": "La Pastelería La T",
    "slug": "sensores",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/logo-la-t.png",
    "backgroundColor": "#FDF4D8",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-la-t.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF4D8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Pastelería La T usa el acelerómetro para el juego «Agita y gana» y para el laboratorio de sensores."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF4D8",
        "foregroundImage": "./assets/logo-la-t.png",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/logo-la-t.png",
      "lang": "es"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a $(PRODUCT_NAME) guardar las fotografías capturadas en tu galería.",
          "savePhotosPermission": "Permite a $(PRODUCT_NAME) guardar las fotografías capturadas en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
